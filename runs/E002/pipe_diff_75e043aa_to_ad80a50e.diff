+            man = {"arm_id": f"{a.exp}-{a.from_exp}-{arm}-k{a.k}", "seed": seed, "split": s,
+                   "config_id": f"{parent}-k{a.k}", "code_revision": f"eval {code_revision()} / pipe {PIPE_REV}",
+                   "model_artifact": os.path.relpath(art, ROOT).replace(os.sep, "/"),
